<UserControl x:Class="SmartWashWidget.Controls.MachineCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- Frosted-Glass-Karte: bewusst extrem durchscheinend (nur 8 % weisser Schimmer), damit sie
         die Transparenz des Hauptfensters NICHT blockiert. Der Slider "Glas-Toenung" wirkt allein
         auf den RootBorder des Hauptfensters - die Karte bleibt immer gleich leicht. -->
    <Border x:Name="CardBorder"
            CornerRadius="10"
            Background="#14FFFFFF"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="12,10,12,11">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Akzentstreifen oben (leuchtend) -->
            <Border x:Name="AccentStripe" Grid.Row="0" Height="2" CornerRadius="1"
                    VerticalAlignment="Top" Margin="-12,-10,-12,8" Opacity="0.9" />

            <Grid Grid.Row="0" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <!-- Alle Kartentexte setzt der Code (MachineCard.UpdateTexts) aus dem aktiven
                         Sprachvorrat - die XAML-Werte sind nur der Gestaltungs-Startpunkt. -->
                    <TextBlock x:Name="DeviceName" Style="{StaticResource CardTitle}"
                               Text="{DynamicResource Str_Device_Generic}" />
                    <TextBlock x:Name="DeviceSub" FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}"
                               Text="{DynamicResource Str_Sub_SmartThings}" Margin="0,1,0,0" />
                </StackPanel>

                <Border x:Name="StatusPill" Grid.Column="1" Style="{StaticResource StatusPill}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource OkBrush}" Margin="0,0,6,0" />
                        <TextBlock x:Name="StatusText" Text="{DynamicResource Str_Status_Idle}" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="0,10,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ContentControl x:Name="DrumHost" Grid.Column="0" Width="132" Height="132"
                                Focusable="False" IsTabStop="False" />

                <StackPanel Grid.Column="1" Margin="12,2,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TimeText" Style="{StaticResource BigTime}" Text="01:24 h" />

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Path x:Name="PhaseIcon" Width="12" Height="12" Margin="0,0,7,0"
                              VerticalAlignment="Center" Stretch="Uniform" />
                        <TextBlock x:Name="PhaseText" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{DynamicResource Str_Phase_standby}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="HintText" FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}"
                               TextWrapping="Wrap" Margin="0,7,0,0" MaxWidth="150"
                               Text="{DynamicResource Str_Hint_Connected}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar x:Name="Progress" Grid.Column="0" Style="{StaticResource GlowProgress}"
                             VerticalAlignment="Center" Value="0" />

                <TextBlock x:Name="PercentText" Grid.Column="1" Margin="9,0,0,0" FontSize="11.5"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                           Text="0 %" MinWidth="38" TextAlignment="Right" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
